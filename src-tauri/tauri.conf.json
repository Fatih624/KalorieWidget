{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalorie Widget",
  "version": "0.3.3",
  "identifier": "de.fatih.kaloriewidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kalorie Widget",
        "width": 416,
        "height": 788,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#00000000",
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "badge",
        "title": "Kalorie · Makros",
        "url": "index.html?view=badge",
        "width": 128,
        "height": 128,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Kalorien und Makros direkt auf deinem Desktop",
    "category": "HealthcareAndFitness",
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
